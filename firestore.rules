rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each player can read and write only their own save.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Leaderboards: anyone can read; a signed-in player can only write
    // their own entry, with sane, well-typed fields.
    match /leaderboards/{board}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && board in ['level1', 'level2', 'level3']
        && request.resource.data.keys().hasOnly(['callsign', 'timeSec', 'kills', 'at'])
        && request.resource.data.callsign is string
        && request.resource.data.callsign.size() > 0
        && request.resource.data.callsign.size() <= 20
        && request.resource.data.timeSec is number
        && request.resource.data.timeSec >= 10
        && request.resource.data.kills is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
